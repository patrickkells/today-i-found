{
  "name": "today-i-found",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.*",
    "test:feedback": "node --test tests/feedback-worker.test.mjs tests/feedback-schema.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "validate:edition": "node scripts/validate-edition.mjs data/editions/2026-08-20.json",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "validate:archives": "node scripts/validate-archives.mjs",
    "curate:dry-run": "node scripts/publish-edition.mjs --input data/editions/2026-08-20.json --dry-run",
    "discover:feeds": "node scripts/discover-feeds.mjs",
    "discover:candidates": "node scripts/discover-candidates.mjs",
    "audit:sources": "node scripts/audit-sources.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12"
  }
}
